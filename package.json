{
  "name": "turborepo-app",
  "version": "1.0.2",
  "description": "",
  "packageManager": "pnpm@8.15.7",
  "private": true,
  "type": "module",
  "scripts": {
    "deps:check": "pnpm outdated -r",
    "deps:update": "pnpm update --latest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky install",
    "preinstall": "npx only-allow pnpm",
    "build": "node scripts/build.js",
    "build:test": "node scripts/build.js --mode test",
    "build:prod": "node scripts/build.js --mode production",
    "build:client": "node scripts/build.js --client",
    "build:server": "node scripts/build.js --server",
    "docker:build": "node scripts/docker-build.js",
    "docker:build:tag": "node scripts/docker-build.js --tag",
    "docker:up": "bash scripts/docker-up.sh up",
    "docker:up:build": "bash scripts/docker-up.sh up --build",
    "docker:up:gateway": "bash scripts/docker-up.sh up --gateway",
    "docker:dev": "bash scripts/docker-up.sh up --dev",
    "docker:down": "bash scripts/docker-up.sh down",
    "docker:down:clean": "bash scripts/docker-up.sh down -v",
    "docker:logs": "bash scripts/docker-up.sh logs",
    "docker:status": "bash scripts/docker-up.sh status",
    "docker:restart": "bash scripts/docker-up.sh restart"
  },
  "license": "ISC",
  "devDependencies": {
    "husky": "8.0.3",
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@release-it/conventional-changelog": "10.0.4",
    "conventional-changelog-angular": "8.1.0",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "release-it": "19.2.4"
  }
}
