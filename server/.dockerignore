# 依赖与构建产物（镜像内重新安装/构建）
node_modules
dist
logs

# 版本控制与 IDE
.git
.gitignore
.idea
.vscode
.qoder
.trae

# 环境配置（生产环境通过 docker-compose environment 注入，不入镜像）
.env.development
.env.test

# 锁文件（仅保留 pnpm-lock.yaml）
package-lock.json
yarn.lock

# 文档与脚本（运行时不需要）
docs
*.md
README.md
CHANGELOG.md
deploy.sh

# 备份与临时文件
*.log
*.tar.gz
backups
